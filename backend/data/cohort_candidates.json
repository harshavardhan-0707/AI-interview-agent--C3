        "topics": ["RAG Evaluation (Ragas)", "Prompt Injection Security", "Guardrails", "Latency & Token Optimization", "Docker Cloud Deployment"],
        "missions": ["m21_ragas_eval", "m22_prompt_security", "m23_docker_cloud_deploy"]
      },
      {
        "id": 8,
        "name": "Production & Capstone",
        "days": [30, 31],
        "topics": ["Production Monitoring", "Observability (LangSmith)", "CI/CD Pipelines", "Capstone Presentation"],
        "missions": ["m24_observability_setup", "m25_capstone_project"]
      }
